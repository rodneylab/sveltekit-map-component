{
	"name": "@rodneylab/sveltekit-map-component",
	"description": "Handy components for building sites in SvelteKit",
	"version": "2.0.5",
	"author": "Rodney Lab <ask@rodneylab.com> (@rodneyLab)",
	"license": "BSD-3-Clause",
	"keywords": [
		"svelte",
		"sveltekit",
		"map",
		"mapbox",
		"openstreetmap"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --plugin=prettier-plugin-svelte --plugin=@trivago/prettier-plugin-sort-imports --check . && eslint .",
		"format": "prettier --plugin=prettier-plugin-svelte --plugin=@trivago/prettier-plugin-sort-imports --write .",
		"prettier:check": "prettier --check --plugin=prettier-plugin-svelte --plugin=@trivago/prettier-plugin-sort-imports ."
	},
	"devDependencies": {
		"@commitlint/config-conventional": "^19.7.1",
		"@eslint/js": "^9.20.0",
		"@sveltejs/adapter-static": "3.0.8",
		"@sveltejs/kit": "2.17.1",
		"@sveltejs/package": "2.3.10",
		"@trivago/prettier-plugin-sort-imports": "^5.2.2",
		"@types/leaflet": "^1.9.16",
		"@types/node": "^22.13.1",
		"@typescript-eslint/eslint-plugin": "^8.24.0",
		"@typescript-eslint/parser": "^8.24.0",
		"commitlint": "^19.7.1",
		"eslint": "^9.20.1",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^2.46.1",
		"globals": "^15.14.0",
		"husky": "^9.1.7",
		"leaflet": "^1.9.4",
		"prettier": "^3.5.0",
		"prettier-plugin-svelte": "^3.3.3",
		"svelte": "^5.19.10",
		"svelte-check": "^4.1.4",
		"svelte-preprocess": "^6.0.3",
		"svelte2tsx": "^0.7.34",
		"tslib": "^2.8.1",
		"typescript": "^5.7.3",
		"typescript-eslint": "^8.24.0",
		"vite": "^6.1.0"
	},
	"type": "module",
	"exports": {
		".": "./dist/index.js",
		"./svelte": "./dist/index.js",
		"./Map.svelte": "./dist/Map.svelte"
	},
	"peerDependencies": {
		"leaflet": "^1.9.4"
	},
	"svelte": "./dist/index.js",
	"dependencies": {
		"@sveltejs/vite-plugin-svelte": "^5.0.3"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@sveltejs/kit",
			"esbuild",
			"svelte-preprocess"
		]
	}
}
